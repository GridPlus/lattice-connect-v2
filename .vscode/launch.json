{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug EIP1193 Tests",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "test",
        "src/services/useEIP1193Provider.integration.test.ts",
        "--runInBand"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "NODE_ENV": "test"
      },
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/connect"
    }
  ]
} 