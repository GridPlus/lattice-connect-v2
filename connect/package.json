{
  "name": "server",
  "private": true,
  "version": "1.1.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start:direct": "tsx watch ./src/direct.ts",
    "start:direct:mqtt": "DEBUG='mqttjs*' NODE_ENV=development tsx watch ./src/direct.ts",
    "build": "tsc",
    "test": "node --import tsx --test --test-timeout=5000 test/unit/*.test.ts",
    "prod": "tsc; NODE_ENV=production node ./dist/direct.js"
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "mqtt": "^5.16.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
