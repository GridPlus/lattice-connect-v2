{
  "name": "lattice-connect-server",
  "private": true,
  "version": "0.1.0",
  "description": "Node.js server for GridPlus Lattice1 connectivity",
  "main": "dist/index.js",
  "scripts": {
    "start": "NODE_ENV=production node dist/index.js",
    "dev": "NODE_ENV=development nodemon --exec ts-node src/index.ts",
    "dev:mqtt": "DEBUG='mqttjs*' NODE_ENV=development nodemon --exec ts-node src/index.ts",
    "dev:direct": "nodemon --exec ts-node src/direct.ts",
    "dev:direct:mqtt": "DEBUG='mqttjs*' NODE_ENV=development nodemon --exec ts-node src/direct.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "NODE_ENV=test jest --testPathPattern=test\\.ts$ --testPathIgnorePatterns=integration\\.test\\.ts$",
    "test:int": "NODE_ENV=test jest --testPathPattern=integration\\.test\\.ts$",
    "test:all": "NODE_ENV=test jest",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "docker:mqtt:up": "cd ../mqtt-broker && docker-compose up -d",
    "docker:mqtt:down": "cd ../mqtt-broker && docker-compose down",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "docker:restart": "docker-compose restart",
    "docker:test:up": "docker-compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker-compose -f docker-compose.test.yml down",
    "docker:test": "./scripts/test-docker-setup.sh",
    "mqtt:test": "node ./scripts/test-mqtt-connection.js",
    "pretest:integration": "yarn docker:test:up && sleep 5",
    "test:integration": "NODE_ENV=test node -r ts-node/register ./src/index.ts & sleep 5 && yarn test:int && pkill -f 'node'",
    "posttest:integration": "yarn docker:test:down",
    "prepare": "npm run build"
  },
  "dependencies": {
    "async-mqtt": "^2.6.2",
    "bs58": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "express": "^4.21.2",
    "express-pino-logger": "^7.0.0",
    "gridplus-sdk": "^3.4.0",
    "pino-http": "^8.1.1",
    "superagent": "^8.0.0"
  },
  "devDependencies": {
    "@turnkey/api-key-stamper": "^0.4.4",
    "@turnkey/http": "^2.21.0",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.12",
    "@types/express": "^5.0.0",
    "@types/express-pino-logger": "^4.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/serve-static": "^1.15.7",
    "@types/superagent": "^4.1.15",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "nodemon": "^2.0.19",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "viem": "^2.23.12"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "nodemonConfig": {
    "watch": ["src"],
    "ext": "ts,json",
    "ignore": ["src/**/*.spec.ts", "src/**/*.test.ts"],
    "exec": "ts-node src/index.ts"
  }
}
