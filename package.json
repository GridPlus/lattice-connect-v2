{
  "name": "server",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "start": "NODE_ENV=development nodemon ./src/index.ts",
    "start:mqtt": "DEBUG='mqttjs*' NODE_ENV=development nodemon ./src/index.ts",
    "start:direct": "nodemon ./src/direct.ts",
    "start:direct:mqtt": "DEBUG='mqttjs*' NODE_ENV=development nodemon ./src/direct.ts",
    "prod": "tsc --build tsconfig.json; NODE_ENV=production node ./dist/index.js",
    "test": "jest",
    "test:integration": "jest --testMatch '**/src/**/*.integration.test.ts' --forceExit --detectOpenHandles",
    "docker:mqtt:up": "cd ../mqtt-broker && docker-compose up -d",
    "docker:mqtt:down": "cd ../mqtt-broker && docker-compose down",
    "pretest:integration:setup": "yarn docker:mqtt:up && sleep 5",
    "test:integration:setup": "NODE_ENV=test node -r ts-node/register ./src/index.ts & sleep 5 && yarn test:integration && pkill -f 'node'",
    "posttest:integration:setup": "yarn docker:mqtt:down"
  },
  "dependencies": {
    "async-mqtt": "^2.6.2",
    "bs58": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "express": "^4.21.2",
    "express-pino-logger": "^7.0.0",
    "gridplus-sdk": "^3.4.0",
    "pino-http": "^8.1.1",
    "superagent": "^8.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.12",
    "@types/express": "^5.0.0",
    "@types/express-pino-logger": "^4.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/serve-static": "^1.15.7",
    "@types/superagent": "^4.1.15",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "nodemon": "^2.0.19",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "node --require ts-node/register/transpile-only"
    }
  }
}
