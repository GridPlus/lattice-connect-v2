{
  "name": "lattice-connect-server",
  "private": true,
  "version": "0.1.0",
  "description": "Node.js server for GridPlus Lattice1 connectivity",
  "main": "dist/index.js",
  "scripts": {
    "start": "NODE_ENV=production node dist/index.js",
    "dev": "NODE_ENV=development nodemon --exec ts-node src/index.ts",
    "dev:mqtt": "DEBUG='mqttjs*' NODE_ENV=development nodemon --exec ts-node src/index.ts",
    "debug": "DEBUG='gridplus-sdk:*,mqttjs*,lattice-connect:*' NODE_ENV=development nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "NODE_ENV=test jest --config jest.unit.config.js --testPathPattern=test\\.ts$ --testPathIgnorePatterns=integration\\.test\\.ts$",
    "test:int": "NODE_ENV=test jest --config jest.unit.config.js --testPathPattern=controllers/.*\\.integration\\.test\\.ts$",
    "test:all": "NODE_ENV=test jest --config jest.unit.config.js",
    "test:e2e": "NODE_ENV=test vitest run --config vitest.e2e.config.ts",
    "test:e2e:api": "NODE_ENV=test vitest run --config vitest.e2e.config.ts 'e2e/api.e2e.test.ts'",
    "test:e2e:errors": "NODE_ENV=test vitest run --config vitest.e2e.config.ts 'e2e/errors.e2e.test.ts'",
    "test:e2e:websocket": "NODE_ENV=test vitest run --config vitest.e2e.config.ts 'e2e/websocket.e2e.test.ts'",
    "test:e2e:sequential": "yarn test:e2e:api && yarn test:e2e:errors && yarn test:e2e:websocket",
    "test:e2e:watch": "NODE_ENV=test vitest watch --config vitest.e2e.config.ts",
    "test:e2e:ui": "NODE_ENV=test vitest --ui --config vitest.e2e.config.ts",
    "docker:mqtt:up": "cd ../mqtt-broker && docker-compose up -d",
    "docker:mqtt:down": "cd ../mqtt-broker && docker-compose down",
    "docker:test:up": "cd ../mqtt-broker && docker-compose up -d && cd ../rabbitmq-broker && docker-compose up -d",
    "docker:test:down": "cd ../mqtt-broker && docker-compose down && cd ../rabbitmq-broker && docker-compose down",
    "docker:test": "./scripts/test-docker-setup.sh",
    "mqtt:test": "node ./scripts/test-mqtt-connection.js",
    "pretest:integration": "yarn docker:test:up && sleep 5",
    "test:integration": "NODE_ENV=test node -r ts-node/register ./src/index.ts & sleep 5 && yarn test:int && pkill -f 'node'",
    "posttest:integration": "yarn docker:test:down",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@ethersproject/units": "^5.8.0",
    "async-mqtt": "^2.6.2",
    "bs58": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "express": "^4.21.2",
    "express-pino-logger": "^7.0.0",
    "gridplus-sdk": "^3.4.0",
    "ox": "^0.7.0",
    "pino-http": "^8.1.1",
    "superagent": "^8.0.0",
    "viem": "^2.23.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@turnkey/api-key-stamper": "^0.4.4",
    "@turnkey/http": "^2.21.0",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.12",
    "@types/express": "^5.0.0",
    "@types/express-pino-logger": "^4.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/serve-static": "^1.15.7",
    "@types/superagent": "^4.1.15",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitest/ui": "^3.0.9",
    "axios": "^1.6.8",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "happy-dom": "^17.4.4",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "nodemon": "^2.0.19",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1",
    "ws": "^8.16.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,json",
    "ignore": [
      "src/**/*.spec.ts",
      "src/**/*.test.ts"
    ],
    "exec": "ts-node src/index.ts"
  }
}
